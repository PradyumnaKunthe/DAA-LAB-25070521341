#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
    int distance[MAX], visited[MAX], parent[MAX];
    int i, j, u, min;

    for (i = 1; i <= n; i++) {
        distance[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
    }

    distance[startnode] = 0;

    for (i = 1; i <= n; i++) {
        min = INFINITY;
        u = -1;

        for (j = 1; j <= n; j++) {
            if (!visited[j] && distance[j] < min) {
                min = distance[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (j = 1; j <= n; j++) {
            if (!visited[j] && G[u][j] > 0 &&
                distance[u] != INFINITY &&
                distance[u] + G[u][j] < distance[j]) {
                distance[j] = distance[u] + G[u][j];
                parent[j] = u;
            }
        }
    }

    printf("Node\tDistance\tPath\n");

    for (i = 1; i <= n; i++) {
        if (i == startnode)
            continue;

        printf("%4d\t", i);

        if (distance[i] == INFINITY) {
            printf("%8s\tNO PATH\n", "INF");
        } else {
            int path[MAX], count = 0;
            int current = i;

            while (current != -1) {
                path[count++] = current;
                current = parent[current];
            }

            printf("%8d\t", distance[i]);

            for (j = 0; j < count; j++) {
                if (j > 0)
                    printf("<-");
                printf("%d", path[j]);
            }

            printf("\n");
        }
	}
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
