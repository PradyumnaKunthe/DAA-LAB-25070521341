
#include <stdio.h>
#include <limits.h>

#define MAX 20

int n;
int cost[MAX][MAX];
int visited[MAX];
int minCost = INT_MAX;

void tsp(int city, int count, int totalCost) {
    int i;

    if (count == n) {
        if (cost[city][0] != -1) {
            int finalCost = totalCost + cost[city][0];

            if (finalCost < minCost)
                minCost = finalCost;
        }
        return;
    }

    for (i = 0; i < n; i++) {
        if (!visited[i] && cost[city][i] != -1) {
            visited[i] = 1;

            tsp(i, count + 1, totalCost + cost[city][i]);

            visited[i] = 0;
        }
    }
}

int main() {
    int i, j;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    for (i = 0; i < n; i++)
        visited[i] = 0;

    visited[0] = 1;

    tsp(0, 1, 0);

    if (minCost == INT_MAX)
        printf("-1\n");
    else
        printf("%d\n", minCost);

    return 0;
}

