#include <stdio.h>

int main()
{
    int m, n;
    int p, q;

    int A[100][100];
    int B[100][100];
    int C[100][100];

    // Read dimensions of A
    scanf("%d %d", &m, &n);

    // Read matrix A
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < n; j++)
        {
            scanf("%d", &A[i][j]);
        }
    }

    // Read dimensions of B
    scanf("%d %d", &p, &q);

    // Check multiplication condition
    if (n != p)
    {
        printf("Invalid input");
        return 0;
    }

    // Read matrix B only if multiplication is possible
    for (int i = 0; i < p; i++)
    {
        for (int j = 0; j < q; j++)
        {
            scanf("%d", &B[i][j]);
        }
    }

    // Matrix multiplication
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < q; j++)
        {
            C[i][j] = 0;

            for (int k = 0; k < n; k++)
            {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Print result
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < q; j++)
        {
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
