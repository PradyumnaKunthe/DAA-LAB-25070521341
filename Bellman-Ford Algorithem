#include <stdio.h>
#define MAX 1005
#define INF 999999999

struct Edge {
    int u, v, w;
};

struct Edge edges[MAX * MAX];

void bellmanFord(int V, int E, int src) {
    int dist[MAX], parent[MAX];
    int i, j;

    for (i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }

    dist[src] = 0;

    for (i = 1; i < V; i++) {
        int changed = 0;

        for (j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
                changed = 1;
            }
        }

        if (!changed)
            break;
    }

    for (j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            printf("Negative cycle detected\n");
            return;
        }
    }

    for (i = 1; i <= V; i++) {
        if (i == src)
            continue;

        if (dist[i] == INF) {
            printf("%d INF None\n", i);
        } else {
            int path[MAX], count = 0;
            int current = i;

            while (current != -1 && count < MAX) {
                path[count++] = current;
                current = parent[current];
            }

            printf("%d %d ", i, dist[i]);

            for (j = count - 1; j >= 0; j--) {
                printf("%d", path[j]);
                if (j > 0)
                    printf("->");
            }

            printf("\n");
        }
    }
}

int main() {
    int V, E, src, i;

    scanf("%d", &V);
    scanf("%d", &E);

    for (i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].u,
              &edges[i].v,
              &edges[i].w);
    }

    scanf("%d", &src);

    bellmanFord(V, E, src);

    return 0;
}
